<Window x:Class="DogruTemin.Wpf.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/AppIcon.ico"
        Title="DoğruTemin - Belge Önizleme"
        Width="1080" Height="820" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#E9EEF4">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#031C38" Padding="20,0">
            <Grid>
                <TextBlock Text="BELGE ÖNİZLEME" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="A4 • DoğruTemin C# belge motoru" Foreground="#B9C8D8" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <DocumentViewer x:Name="Viewer" Grid.Row="1" Margin="12" Background="#DCE4EC"/>
    </Grid>
</Window>
