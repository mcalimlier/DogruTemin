                                <StackPanel>
                                    <TextBlock Text="VERGİ DAİRESİ" Style="{StaticResource PremiumFieldLabel}"/>
                                    <TextBox x:Name="OfferTaxOfficeBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="OfferEditorText_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PremiumPanel}" Padding="0" ClipToBounds="True">
                            <DataGrid x:Name="OfferGrid" Height="310" Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding OfferRows}" AutoGenerateColumns="False"
                                      RowHeight="42" SelectionUnit="Cell" SelectionMode="Single"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      CellEditEnding="OfferGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding No}" Width="38" IsReadOnly="True" ElementStyle="{StaticResource PremiumGridCellText}"/>
                                    <DataGridTextColumn Header="ÜRÜN / MAL / HİZMET" Binding="{Binding ProductName}" Width="2.15*" IsReadOnly="True" ElementStyle="{StaticResource PremiumGridCellText}"/>
                                    <DataGridTextColumn Header="MİKTAR" Binding="{Binding QuantityDisplay}" Width="0.8*" IsReadOnly="True" ElementStyle="{StaticResource PremiumGridCellText}"/>
                                    <DataGridTextColumn Header="YAKL. BİRİM FİYAT" Binding="{Binding ApproximatePrice, UpdateSourceTrigger=PropertyChanged}" Width="1.35*">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource PremiumDataGridCell}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApproximatePriceMissing}" Value="True">
                                                        <Setter Property="Background" Value="#FFF0F0"/>
                                                        <Setter Property="BorderBrush" Value="#D64545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="ToolTip" Value="Yaklaşık birim fiyat henüz girilmedi. Kayıt yapılabilir; ancak yaklaşık maliyet hesabı ve ilgili belge eksik kalır."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApproximatePriceMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#B42318"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PremiumGridCellEditTextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApproximatePriceMissing}" Value="True">
                                                        <Setter Property="Background" Value="#FFF7F7"/>
                                                        <Setter Property="Foreground" Value="#7A1E16"/>
                                                        <Setter Property="CaretBrush" Value="#7A1E16"/>
                                                        <Setter Property="SelectionBrush" Value="#F3B8B3"/>
                                                        <Setter Property="BorderBrush" Value="#D64545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="NİHAİ BİRİM FİYAT" Binding="{Binding FinalPrice, UpdateSourceTrigger=PropertyChanged}" Width="1.35*">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource PremiumDataGridCell}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFinalPriceMissing}" Value="True">
                                                        <Setter Property="Background" Value="#FFF0F0"/>
                                                        <Setter Property="BorderBrush" Value="#D64545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="ToolTip" Value="Nihai birim fiyat henüz girilmedi. Kayıt yapılabilir; ancak firma değerlendirmeye alınmaz."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFinalPriceMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#B42318"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PremiumGridCellEditTextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFinalPriceMissing}" Value="True">
                                                        <Setter Property="Background" Value="#FFF7F7"/>
                                                        <Setter Property="Foreground" Value="#7A1E16"/>
                                                        <Setter Property="CaretBrush" Value="#7A1E16"/>
                                                        <Setter Property="SelectionBrush" Value="#F3B8B3"/>
                                                        <Setter Property="BorderBrush" Value="#D64545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="OfferEditorStatusBanner" Grid.Column="0" Background="#EAF3FF" BorderBrush="#BDD5F2" BorderThickness="1.5" CornerRadius="9" Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="OfferEditorStatusIconBorder" Width="30" Height="30" CornerRadius="15" Background="#D8E9FF" VerticalAlignment="Center">
                                        <TextBlock x:Name="OfferEditorStatusIcon" Text="i" FontSize="17" FontWeight="Bold" Foreground="#1D5FA7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="OfferEditorStatusTitle" Text="TEKLİF DURUMU" FontSize="14" FontWeight="Bold" Foreground="#184B7A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="OfferEditorStatusText" Text="Önce firma ve ürün bilgilerini oluşturun." FontSize="12.5" FontWeight="SemiBold" Foreground="#365F87" Margin="0,3,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="OfferSaveButton" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource ModernButton}" Content="TEKLİFİ KAYDET" Height="42" FontSize="13" Click="SaveOffer_Click"/>
                        </Grid>
                    </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
