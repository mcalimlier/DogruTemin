<Window x:Class="DogruTemin.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DogruTemin.Wpf"
        xmlns:models="clr-namespace:DogruTemin.Wpf.Models"
        Icon="Assets/AppIcon.ico"
        Title="DoğruTemin - Doğrudan Temin Süreç Yönetim Programı"
        Width="1280" Height="834"
        SizeToContent="Manual" ResizeMode="CanResizeWithGrip" MinWidth="760" MinHeight="520"
        WindowStartupLocation="Manual" WindowStyle="None" ShowInTaskbar="True" Background="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <Grid x:Name="AppScaleViewbox">
    <Border CornerRadius="15" BorderBrush="#35546F" BorderThickness="1" Background="#031C38" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ÜST BAR -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#031C38" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition x:Name="HeaderStatusColumn" Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                    <Image Source="Assets/Logo.png" Width="170" Stretch="Uniform"/>
                </StackPanel>

                <StackPanel x:Name="HeaderSaveStatus" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
<Border Background="#092746" CornerRadius="9" BorderBrush="#24496B" BorderThickness="1" Padding="13,8" Margin="0" Width="188">
                        <StackPanel>
                            <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse x:Name="SaveStatusDot" Width="9" Height="9" Fill="#43C77A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="SaveStatusText" Text="Kaydedildi" Foreground="#DDF6E7" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition x:Name="HeaderReadinessColumn" Width="122"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="98"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="98"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HeaderActiveOperation" Grid.Column="0" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="12,7" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="AKTİF İŞLEM" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ActiveOperationText" Text="Yeni İşlem" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="HeaderReadiness" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
                            <TextBlock Text="HAZIRLIK" Foreground="#8FA8C0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="DURUMU" Foreground="#C3CFDC" FontSize="10.5" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Grid Width="48" Height="48">
                            <Ellipse Stroke="#29445F" StrokeThickness="5"/>
                            <Path x:Name="HeaderReadinessArc" Stroke="#FFB41F" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M24,4 A20,20 0 1 1 4,24"/>
                            <TextBlock x:Name="HeaderReadinessText" Text="%0" Foreground="White" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="4" Style="{StaticResource ModernButton}" Content="KAYDET" Width="98" Click="Save_Click" ToolTip="Kaydet (Ctrl+S)"/>
                    <Button Grid.Column="6" Style="{StaticResource ModernButton}" Content="TEMİZLE" Width="98" Background="{StaticResource Gold500Brush}" Foreground="#06172A" Click="Clear_Click"/>
                    <Button Grid.Column="7" Content="—" ToolTip="Küçült" FontSize="21" FontWeight="SemiBold" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48" Cursor="Hand" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeRestoreButton" Grid.Column="8" ToolTip="Tam ekran" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48" Cursor="Hand" Click="MaximizeRestore_Click">
                        <TextBlock x:Name="MaximizeRestoreIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="15" FontWeight="SemiBold"/>
                    </Button>
                    <Button Grid.Column="9" Content="×" ToolTip="Kapat" FontSize="25" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48" Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Grid>

            <!-- SOL MENÜ -->
            <Grid Grid.Row="1" Grid.Column="0" Background="#031C38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="84"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel MinHeight="{Binding ViewportHeight, ElementName=NavigationScroll}" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                    <!-- 1. GRUP: ANA EKRAN -->
                    <Button x:Name="NavHome" Style="{StaticResource NavButton}" Tag="Active" Click="NavHome_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="17" Width="32"/><TextBlock Text="ANA EKRAN" VerticalAlignment="Center"/></StackPanel>
                    </Button>

                    <Border Height="3" Background="#557A9D" Margin="16,6,16,6" CornerRadius="1.5"/>

                    <!-- 2. GRUP: VERİ GİRİŞİ -->
                    <StackPanel x:Name="DataEntrySubmenu" Margin="0,1,0,4">
                        <Button x:Name="NavInstitution" Style="{StaticResource SubNavButton}" Click="NavInstitution_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="17" Width="30"/><TextBlock Text="KURUM BİLGİSİ" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavGeneral" Style="{StaticResource SubNavButton}" Click="NavGeneral_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" FontSize="17" Width="30"/><TextBlock Text="MAL/HİZMET BİLGİSİ" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavFirmsOffers" Style="{StaticResource SubNavButton}" Click="NavFirmsOffers_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE731;" FontSize="17" Width="30"/><TextBlock Text="FİRMALAR/TEKLİFLER" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavApprovalDocument" Style="{StaticResource SubNavButton}" Click="NavApprovalDocument_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="17" Width="30"/><TextBlock Text="ONAY BELGESİ" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavDocumentsDates" Style="{StaticResource SubNavButton}" Click="NavDocumentsDates_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="17" Width="30"/><TextBlock Text="BELGELER/TARİHLER" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>

                    <Border Height="3" Background="#557A9D" Margin="16,6,16,6" CornerRadius="1.5"/>

</StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" x:Name="BottomNavigation">                    <!-- 3. GRUP: KONTROL / RAPOR / ARŞİV -->
                    <Button x:Name="NavControl" Style="{StaticResource NavButton}" Click="NavControl_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="17" Width="32"/><TextBlock Text="KONTROL MERKEZİ" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavStatistics" Style="{StaticResource NavButton}" Click="NavStatistics_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="17" Width="32"/><TextBlock Text="İSTATİSTİKLER" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavArchive" Style="{StaticResource NavButton}" Click="NavArchive_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="17" Width="32"/><TextBlock Text="İŞLEM ARŞİVİ" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17" Width="32"/><TextBlock Text="AYARLAR" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="NavAboutSafety" Style="{StaticResource NavButton}" Click="NavAboutSafety_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="17" Width="32"/><TextBlock Text="HAKKINDA/GÜVENLİK" VerticalAlignment="Center"/></StackPanel></Button>
</StackPanel>
                    </DockPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Margin="18,7,18,10" Padding="14,9" CornerRadius="9" Background="#082845" BorderBrush="#73581E" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Created by" Foreground="#A8BCD0" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Murat ÇALIMLIER" Foreground="#FFB41F" FontSize="19" FontWeight="Bold" Margin="0,2,0,0"/>
                        <Border Height="2" Width="74" Background="#FFB41F" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="1"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- İÇERİK -->
            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="13,0,13,0" Padding="16">
                <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="WorkspaceLayout" MinWidth="700">
                    <!-- ANA EKRAN -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,16">
                            <TextBlock Text="DOĞRUTEMİN İŞLEM PANELİ" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Aktif işlemin mali, operasyonel ve belge durumunu tek bakışta izleyin." Style="{StaticResource PageSubtitle}"/>

                            <!-- Aktif işlem / hazırlık kahraman kartı -->
                            <Border CornerRadius="12" Padding="20,15" Margin="0,0,0,12" BorderBrush="{StaticResource PremiumGoldBorderBrush}" BorderThickness="1.25">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#082947" Offset="0"/>
                                        <GradientStop Color="#0C3A62" Offset="0.62"/>
                                        <GradientStop Color="#123F67" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1D4B70" CornerRadius="11" Padding="9,4" Margin="0,0,10,0">
                                                <TextBlock Text="AKTİF İŞLEM" Foreground="#D9E9F6" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock x:Name="HomeWarningCountText" Text="0 UYARI" Foreground="#FFC75B" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HomeJobTitleText" Text="Henüz aktif işlem başlığı girilmedi" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,7,24,0"/>
                                        <TextBlock x:Name="HomeApprovalDateText" Text="Harcama belgesi tarihi: Henüz belirtilmedi" Foreground="#C5D7E7" FontSize="12.5" Margin="0,5,0,0"/>

                                        <Grid Width="690" HorizontalAlignment="Left" Margin="0,12,0,0">
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="GENEL HAZIRLIK" Foreground="#BFD2E3" FontSize="10.5" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="HomeReadinessText" Text="%0" Foreground="#FFBF36" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Border Height="8" Background="#315371" CornerRadius="5"/>
                                                <Border x:Name="HomeReadinessBar" Height="8" Width="0" HorizontalAlignment="Left" Background="#FFB41F" CornerRadius="5"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="HomeReadinessHintText" Text="Süreç bilgileri girildikçe hazırlık durumu otomatik güncellenir." Foreground="#AFC5D8" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="11" Padding="15,12" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="İŞLEM NO" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="HomeOperationNumberText" Text="Henüz yok" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <Border Height="1" Background="#315371" Margin="0,11,0,9"/>
                                            <TextBlock Text="SON KAYIT" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="HomeHeroLastSavedText" Text="Henüz kaydedilmedi" Foreground="#DCE9F4" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Akıllı iş akışı -->
                            <Border Style="{StaticResource PremiumPanel}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Fill="{StaticResource Gold500Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="AKILLI İŞ AKIŞI" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Gold500Brush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Her kart mevcut durumu ve ilgili aşamaya geçişi tek yerde gösterir." Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="11.5" Margin="17,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="#163D5E" BorderBrush="#4B6F8D" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeStageSummaryText" Text="0 / 5 TAMAM" Foreground="{StaticResource Gold500Brush}" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <UniformGrid Columns="5">
                                        <Border Background="#092A49" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="0,0,5,0" Padding="10">
                                            <StackPanel>
                                                <Grid><TextBlock Text="01  KURUM / KOMİSYON" FontWeight="Bold" FontSize="11.5" Foreground="White"/><TextBlock x:Name="HomeStageCommissionStatus" Text="EKSİK" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/></Grid>
                                                <TextBlock x:Name="HomeStageCommissionDetail" Text="Kurum ve komisyon bilgilerini tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="11" Margin="0,6,0,7" MinHeight="34"/>
                                                <Button Style="{StaticResource ModernButton}" Content="AÇ" Width="62" Height="28" HorizontalAlignment="Right" Padding="8,3" Click="NavInstitution_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#092A49" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0" Padding="10">
                                            <StackPanel>
                                                <Grid><TextBlock Text="02  MAL / HİZMET" FontWeight="Bold" FontSize="11.5" Foreground="White"/><TextBlock x:Name="HomeStageGeneralStatus" Text="EKSİK" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/></Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,1"><TextBlock x:Name="HomeProductCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold500Brush}"/><TextBlock Text=" ürün" VerticalAlignment="Bottom" Margin="3,0,0,3" Foreground="#B9CBDA" FontSize="11"/></StackPanel>
                                                <TextBlock x:Name="HomeProductCountHintText" Text="En az 1 gerekli" Foreground="#91ABC0" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="HomeStageGeneralDetail" Text="İş başlığı ve ürünleri tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,5" MinHeight="28"/>
                                                <Button Style="{StaticResource ModernButton}" Content="AÇ" Width="62" Height="28" HorizontalAlignment="Right" Padding="8,3" Click="NavGeneral_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#092A49" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0" Padding="10">
                                            <StackPanel>
                                                <Grid><TextBlock Text="03  FİRMALAR / TEKLİFLER" FontWeight="Bold" FontSize="11.5" Foreground="White"/><TextBlock x:Name="HomeStageFirmsStatus" Text="EKSİK" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/></Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,1"><TextBlock x:Name="HomeFirmCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#7EE2A6"/><TextBlock Text=" firma" VerticalAlignment="Bottom" Margin="3,0,0,3" Foreground="#B9CBDA" FontSize="11"/></StackPanel>
                                                <TextBlock x:Name="HomeFirmCountHintText" Text="En az 3 gerekli" Foreground="#91ABC0" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="HomeStageFirmsDetail" Text="Firma ve teklifleri tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,5" MinHeight="28"/>
                                                <Button Style="{StaticResource ModernButton}" Content="AÇ" Width="62" Height="28" HorizontalAlignment="Right" Padding="8,3" Click="NavFirmsOffers_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#092A49" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0" Padding="10">
                                            <StackPanel>
                                                <Grid><TextBlock Text="04  BELGELER / TARİHLER" FontWeight="Bold" FontSize="11.5" Foreground="White"/><TextBlock x:Name="HomeStageDatesStatus" Text="EKSİK" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/></Grid>
                                                <TextBlock Text="Tarih ve belge düzeni" Foreground="#D8E8F5" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                <TextBlock x:Name="HomeStageDatesDetail" Text="Belge tarihlerini tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,7" MinHeight="47"/>
                                                <Button Style="{StaticResource ModernButton}" Content="AÇ" Width="62" Height="28" HorizontalAlignment="Right" Padding="8,3" Click="NavDocumentsDates_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#092A49" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0,0,0" Padding="10">
                                            <StackPanel>
                                                <Grid><TextBlock Text="05  ÇIKTILAR" FontWeight="Bold" FontSize="11.5" Foreground="White"/><TextBlock x:Name="HomeStageOutputStatus" Text="EKSİK" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/></Grid>
                                                <TextBlock Text="Resmî belge hazırlığı" Foreground="#D8E8F5" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                <TextBlock x:Name="HomeStageOutputDetail" Text="Ön hazırlık ve nihai belgeleri kontrol edin." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,7" MinHeight="47"/>
                                                <Button Style="{StaticResource ModernButton}" Content="AÇ" Width="62" Height="28" HorizontalAlignment="Right" Padding="8,3" Click="NavOutput_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- DoğruFatura mali bilgi kartı dili -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="MALİ ÖZET" Foreground="#031C38" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="Firma teklifleri ve piyasa araştırması esas alınır" Foreground="#6A7C90" FontSize="13.5" HorizontalAlignment="Right"/>
                            </Grid>
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <Border Style="{StaticResource ProcurementMetricCard}" Padding="14,11" Margin="0,0,4,0" SnapsToDevicePixels="True">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Image Grid.Column="1" Source="{StaticResource MetricCoins}" Width="32" Height="32" Opacity="0.75" IsHitTestVisible="False"/><StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="YAKLAŞIK MALİYET" Foreground="#D4E1ED" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="HomeApproximateTotalText" Text="—" Foreground="#FFE2A1" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Firma ortalamaları" Foreground="#D4E1ED" FontSize="12.5"/>
                                    </StackPanel></Grid>
                                </Border>
                                <Border Style="{StaticResource ProcurementMetricCard}" Padding="14,11" Margin="3,0" SnapsToDevicePixels="True">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Image Grid.Column="1" Source="{StaticResource MetricTransfer}" Width="32" Height="32" Opacity="0.75" IsHitTestVisible="False"/><StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="NİHAİ TOPLAM" Foreground="#D4E1ED" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="HomeFinalTotalText" Text="—" Foreground="#FFE2A1" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="En düşük toplam" Foreground="#D4E1ED" FontSize="12.5"/>
                                    </StackPanel></Grid>
                                </Border>
                                <Border Style="{StaticResource ProcurementMetricCard}" Padding="14,11" Margin="3,0" SnapsToDevicePixels="True">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Image Grid.Column="1" Source="{StaticResource MetricShield}" Width="32" Height="32" Opacity="0.75" IsHitTestVisible="False"/><StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="FARK" Foreground="#D4E1ED" FontSize="12.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="HomeDifferenceText" Text="—" Foreground="#FFE2A1" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="HomeDifferenceHintText" Text="Hesaplama bekleniyor" Foreground="#D4E1ED" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel></Grid>
                                </Border>
                                <Border Style="{StaticResource ProcurementMetricCard}" Padding="14,11" Margin="4,0,0,0" SnapsToDevicePixels="True">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Image Grid.Column="1" Source="{StaticResource MetricBank}" Width="32" Height="32" Opacity="0.75" IsHitTestVisible="False"/><StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="KAZANAN FİRMA" Foreground="#D4E1ED" FontSize="12.5" FontWeight="Bold"/>
