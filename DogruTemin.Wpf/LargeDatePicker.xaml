<UserControl x:Class="DogruTemin.Wpf.LargeDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="35" MinWidth="220"
             Focusable="True" IsTabStop="True"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="LargeDayButton" TargetType="CalendarDayButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LargeMonthButton" TargetType="CalendarButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="InputBorder"
                Background="#082744"
                BorderBrush="#365874"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DateText"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="White"
                         FontFamily="Segoe UI"
                         FontSize="12"
                         FontWeight="SemiBold"
                         IsReadOnly="True"
                         Focusable="False"
                         SelectionBrush="#2D6593"
                         Cursor="Hand"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         PreviewMouseLeftButtonDown="DateText_PreviewMouseLeftButtonDown"/>
                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ClearButton_Click"
                        ToolTip="Tarihi temizle"
                        Focusable="False">
                    <TextBlock Text="×" FontSize="19" FontWeight="SemiBold" Foreground="#D8E4EF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="CalendarButton"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CalendarButton_Click"
                        ToolTip="Tarih seç"
                        Focusable="False">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="20" Foreground="#FFB41F"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=InputBorder}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="6"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#B8C8DA" BorderThickness="1" CornerRadius="10" Padding="12"
                    SnapsToDevicePixels="True">
                <Calendar x:Name="CalendarControl"
                          Width="390"
                          Height="350"
                          FontFamily="Segoe UI"
                          FontSize="18"
                          Background="White"
                          Foreground="#0B1830"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"
                          CalendarDayButtonStyle="{StaticResource LargeDayButton}"
                          CalendarButtonStyle="{StaticResource LargeMonthButton}"
                          SelectedDatesChanged="CalendarControl_SelectedDatesChanged"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
