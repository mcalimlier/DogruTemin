<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DogruTemin</AssemblyName>
    <RootNamespace>DogruTemin.Wpf</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>
    <Version>4.1.0</Version>
    <AssemblyVersion>4.1.0.0</AssemblyVersion>
    <FileVersion>4.1.0.0</FileVersion>
    <InformationalVersion>4.1.0-ARAYUZ-R21</InformationalVersion>
    <Product>DoğruTemin</Product>
    <Description>Doğrudan Temin Süreç Yönetim Programı</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SplashReference.png" />
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DogruTemin.Core\DogruTemin.Core.csproj" />
  </ItemGroup>
</Project>
