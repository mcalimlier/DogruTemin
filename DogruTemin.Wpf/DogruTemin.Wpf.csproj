<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DogruTemin</AssemblyName>
    <RootNamespace>DogruTemin.Wpf</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseAppHost>true</UseAppHost>
    <Product>DoğruTemin</Product>
    <Description>Doğrudan Temin Süreç Yönetim Programı</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SplashReference.png" />
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DogruTemin.Core\DogruTemin.Core.csproj" />
  </ItemGroup>
</Project>
